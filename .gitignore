# ============================================================================
# Strict Allowlist .gitignore for Hermes User Plugin Repository
# Blocks ALL local secrets, databases, caches, logs, and upstream hermes-agent
# by default, and tracks ONLY the update-safe `custom-gateway-hub` plugin files.
# ============================================================================
/*

# Track repository root docs & installer
!/.gitignore
!/README.md
!/config.example.yaml
!/install.ps1

# Track Backend Python User Plugin (`plugins/custom-gateway-hub/`)
!/plugins/
/plugins/*
!/plugins/custom-gateway-hub/
/plugins/custom-gateway-hub/**/__pycache__/
/plugins/custom-gateway-hub/**/*.pyc
/plugins/custom-gateway-hub/**/*.pyo

# Track Desktop Runtime UI Plugin (`desktop-plugins/custom-gateway-hub/`)
!/desktop-plugins/
/desktop-plugins/*
!/desktop-plugins/custom-gateway-hub/
